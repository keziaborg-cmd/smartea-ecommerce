# Copie pra .env (gitignored) e preencha com os valores reais. Nunca commitar
# o .env de verdade nem colar a chave direto no código.

# Obrigatória — chave da API da Anthropic usada nos passos de classificação e redação.
ANTHROPIC_API_KEY=

# Opcional — teto de tokens (entrada + saída, somados) permitido por semana corrida.
# Se não definida, não há teto. Se o teto for atingido no meio de uma execução,
# o pipeline para de chamar a API e registra isso no log, sem derrubar o processo.
WEEKLY_TOKEN_CEILING=

# Obrigatória pra publicar (etapa "publish") — connection string do role
# blog_pipeline_writer (só INSERT, sempre em status "revisao"; ver
# supabase/migrations/20261006000000_blog_posts.sql no repo do e-commerce).
# Pegue o host do pooler no Supabase Dashboard → Settings → Database e troque
# usuário/senha pelos do role: blog_pipeline_writer.wyhdduiqqeusudkgjgwd.
BLOG_DATABASE_URL=
