# Next.js
.next/
out/
node_modules/
.vercel
*.tsbuildinfo

# Env / secrets — never commit real credentials
.env
.env.local
.env*.local

# Worktrees criados pelo Claude Code — cópias completas do repo, nunca versionar
.claude/worktrees/

# Claude Code local permission cache — can retain command history with
# secrets that were typed inline during a session
.claude/settings.local.json

# Supabase CLI
supabase/.temp/

# OS / editor
.DS_Store
*.log
.env*

# blog-pipeline (Python)
blog-pipeline/data/*.sqlite3
blog-pipeline/__pycache__/
blog-pipeline/**/__pycache__/
blog-pipeline/.venv/
blog-pipeline/venv/
blog-pipeline/.pytest_cache/

# ...mas os arquivos de exemplo (sem segredo real) continuam versionados —
# precisa vir depois de todo ".env*" acima, senão a regra de baixo não pega
!.env.example
!**/.env.example
