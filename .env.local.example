# Copy to .env.local (gitignored) and fill in real values. Never commit this file with real values.

# Supabase — same project used by the Smartea+ (Expo) app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mercado Pago Public Key — safe to expose client-side, used to init the Payment Brick.
# The Access Token stays server-side only, as the MERCADOPAGO_ACCESS_TOKEN Edge Function secret
# already set on the linked Supabase project (reused from the app's existing MP integration).
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Tracking
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Contact / WhatsApp CTA (wa.me link, no number formatting beyond digits)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_HANDLE=smartea
NEXT_PUBLIC_CONTACT_EMAIL=ola@smartea.com
