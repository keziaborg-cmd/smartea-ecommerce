  "narrative": {
    "northStar": "A Botica de Jardim",
    "overview": "Antigo no carinho, novo na execução: uma botica de jardim que acende uma luz por dia. A metáfora guia o design por dentro e nunca vira texto de comunicação; para o público, a linguagem é \"jardim\" e \"estufa\".",
    "keyCharacteristics": [
      "Verde-floresta e creme quente como base; vinho e dourado como acentos raros.",
      "Cada chá tem sua própria luz: gradiente, brilho e cores de botão por blend.",
      "Carena para títulos e preços; Montserrat para o resto.",
      "Botões em pílula; um único gesto tátil, o botão com laje sólida.",
      "Latas de produto são o herói visual; sombra só nelas."
    ],
    "rules": [
      {
        "name": "The Luz do Dia Rule",
        "body": "Cada blend carrega a própria luz, vinda de data/teas.ts.",
        "section": "colors"
      },
      {
        "name": "The Vermelho Sem Culpa Rule",
        "body": "Vermelho nunca pune; reacende o foco.",
        "section": "colors"
      },
      {
        "name": "The Escopo Almara+ Rule",
        "body": "Paleta e fontes do Almara+ ficam em /almara-mais.",
        "section": "colors"
      },
      {
        "name": "The Display É Carena Rule",
        "body": "Todo título e preço usa font-display.",
        "section": "typography"
      },
      {
        "name": "The Sombra É do Produto Rule",
        "body": "Só a lata projeta sombra pesada.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar verde-escuro (#013f24) como cor-âncora e creme (#fffdf8) como fundo base.",
      "Do dar a cada blend a própria luz (gradiente, brilho, cores de botão) vinda de data/teas.ts.",
      "Do usar Carena para títulos e preços, Montserrat para o resto.",
      "Do manter botões como pílulas e cartões com cantos de 22–34px.",
      "Do reservar o botão 3D de laje sólida ao Almara+ e à ação \"fiz hoje\".",
      "Do usar \"jardim\" e \"estufa\" na comunicação; \"botica\" é só direção interna de design."
    ],
    "donts": [
      "Don't parecer clínico ou farmacêutico: nada de branco frio, jaleco ou tom de suplemento de academia.",
      "Don't clonar o Duolingo: o Almara+ é gamificado, mas derivado da paleta da marca.",
      "Don't usar vermelho para culpar ou punir; ele reacende o foco.",
      "Don't pôr sombra pesada em superfícies ou cartões; só nas latas.",
      "Don't usar a paleta ou as fontes do Almara+ fora de /almara-mais."
    ]
  }
